{
  "manifest_version": 3,
  "name": "GBSEC - Cyber Resilience Drill",
  "version": "1.0.0",
  "description": "Gamified daily IT cybersecurity retention drill for enterprise teams.",
  "permissions": ["storage", "alarms", "notifications"],
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GBSEC Stats & Leaderboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": ["https://*.supabase.co/*"]
}
